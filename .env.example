# ── Network ──────────────────────────────────────────────────────────────────
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
MNEMOS_CONTRACT_ID=mnemos-contract-xxxxxxxx.testnet
MNEMOS_OWNER_ACCOUNT=mnemos-owner-xxxxxxxx.testnet
MNEMOS_AGENT_ACCOUNT=mnemos-agent-xxxxxxxx.testnet
MNEMOS_BROKER_ACCOUNT=mnemos-broker-xxxxxxxx.testnet

# ── Postgres / broker ────────────────────────────────────────────────────────
POSTGRES_USER=mnemos
POSTGRES_PASSWORD=change-me-in-real-deployments
POSTGRES_DB=mnemos
# Used when running the broker outside Docker:
DATABASE_URL=postgresql+asyncpg://mnemos:change-me-in-real-deployments@localhost:5432/mnemos
SESSION_SECRET=generate-with-openssl-rand-hex-32
SESSION_COOKIE_SECURE=false
BROKER_PUBLIC_URL=http://localhost:8000
BROKER_RECIPIENT=localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Used by the web app inside Docker, where the broker is a compose service.
BROKER_URL=http://broker:8000
BROKER_X25519_PRIVATE_KEY=
BROKER_NEAR_SECRET_KEY=
BROKER_NEAR_ACCOUNT=
LOG_LEVEL=INFO

# ── NEAR AI Cloud ────────────────────────────────────────────────────────────
NEARAI_API_KEY=
NEARAI_MODEL=Qwen/Qwen3.8-27B
NEARAI_BASE_URL=https://cloud-api.near.ai/v1

# ── Policy-bound Agent API / Intents rail (real MAINNET USDC) ──────────────────
# make agent-api-setup provisions these locally. Owner signing key stays in
# .secrets/agent-api-wallets.json; runtime gets only scoped grant tokens.
# This is independent of testnet NEAR credit. Mainnet purchases require funding.
AGENT_API_ENABLED=false
AGENT_API_URL=https://api.demo.agentsonintents.com
AGENT_API_KEY=
AGENT_API_BUYER_ID=
AGENT_API_BUYER_GRANT=
AGENT_API_SELLER_ID=
AGENT_API_SELLER_GRANT=
AGENT_API_BUYER_ACCOUNT=
AGENT_API_SELLER_ACCOUNT=
AGENT_API_ASSET=

# ── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BROKER_URL=http://localhost:8000
NEXT_PUBLIC_CONTRACT_ID=mnemos-contract-xxxxxxxx.testnet
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_BROKER_RECIPIENT=localhost:8000
NEXT_PUBLIC_DEMO_MODE=false
# Local rehearsal only; make demo-ready enables both flags. Never expose the signer publicly.
MNEMOS_LOCAL_DEMO=false
# Restricted function-call runtime key; make agent-key creates it separately.
MNEMOS_AGENT_KEY=
# Gas reservation per request/expiry; doctor checks it against the key allowance.
MNEMOS_REQUEST_GAS=30000000000000
# Server-only. Enables the "local demo signer" button. Never set in production.
DEMO_OWNER_SECRET_KEY=

# ── Rate limits (single broker instance) ─────────────────────────────────────
AUTH_RATE_LIMIT_PER_MINUTE=60
ASK_RATE_LIMIT_PER_MINUTE=10
# memory for one broker, postgres to share one budget across replicas
RATE_LIMIT_BACKEND=memory
# share the activity stream between replicas over a Postgres channel
ACTIVITY_BUS_ENABLED=true
REDTEAM_RATE_LIMIT_PER_MINUTE=3
MAX_REQUEST_BYTES=32768
MAX_VAULT_ITEMS=500
SWEEPER_INTERVAL_SECONDS=60
SWEEPER_ENABLED=true
