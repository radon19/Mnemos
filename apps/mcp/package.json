{
  "name": "@mnemos/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mnemos MCP server: scoped, metered memory access for AI agents",
  "license": "MIT",
  "bin": {
    "mnemos-agent": "./dist/cli.js",
    "mnemos-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "near-api-js": "7.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.2",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
